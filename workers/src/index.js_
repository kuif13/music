    if (!master)
      return errorResponse("Not found", 404);
    const { results: pdfs } = await env2.DB.prepare(
      "SELECT id, description, key_signature, file_name, file_size, created_at FROM pdf_detail WHERE master_id = ? ORDER BY description"
    ).bind(id).all();
    return jsonResponse({ ...master, pdfs });
  }
  if (id && method === "PUT") {
    if (!isAdminOrCM(user))
      return errorResponse("Forbidden", 403);
    const { title: title2, description, keywords, melody, composer, notes } = await request.json();
    if (!title2?.trim())
      return errorResponse("Title is required");
    const row = await env2.DB.prepare("SELECT id FROM music_master WHERE id = ?").bind(id).first();
    if (!row)
      return errorResponse("Not found", 404);
    await env2.DB.prepare(
      `UPDATE music_master SET title=?, description=?, keywords=?, melody=?, composer=?, notes=?, updated_at=? WHERE id=?`
