<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChurchMouse Music</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    </script>

    <style>
        /* ═══════════════════════════════════════════════════════════════════════════
           DESIGN TOKENS
           Palette: Deep charcoal + aged brass + warm ivory
           Feel: Instrument case velvet — rich, tactile, unhurried
        ═══════════════════════════════════════════════════════════════════════════ */

        select {
            cursor: pointer;
            /* existing styles stay as-is */
        }

            select option {
                background: var(--velvet-mid);
                color: var(--ivory);
                font-family: 'Inter', sans-serif;
                padding: 0.5rem;
            }

                /* Improve the selected/hovered option appearance where supported */
                select option:checked,
                select option:hover {
                    background: var(--brass);
                    color: var(--velvet);
                }


        :root {
            --ink: #1a1714;
            --ink-soft: #3d3830;
            --brass: #b8860b;
            --brass-lt: #d4a520;
            --brass-glow: rgba(184,134,11,0.18);
            --ivory: #f5f0e8;
            --ivory-dk: #ede6d6;
            --velvet: #221e1a;
            --velvet-mid: #2e2820;
            --stone: #8a8070;
            --stone-lt: #b5ad9e;
            --danger: #c0392b;
            --success: #2d7a4f;
            --radius: 6px;
            --transition: 180ms ease;
            --shadow-sm: 0 1px 4px rgba(0,0,0,0.25);
            --shadow-md: 0 4px 16px rgba(0,0,0,0.35);
            --shadow-lg: 0 12px 40px rgba(0,0,0,0.5);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--velvet);
            color: var(--ivory);
            min-height: 100vh;
            font-size: 15px;
            line-height: 1.6;
        }

        /* ── Typography ─────────────────────────────────────────────────────────── */
        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            line-height: 1.2;
            font-weight: 600;
        }

        h1 {
            font-size: clamp(1.8rem, 4vw, 2.8rem);
        }

        h2 {
            font-size: clamp(1.4rem, 3vw, 1.9rem);
        }

        h3 {
            font-size: 1.25rem;
        }

        h4 {
            font-size: 1.05rem;
        }

        a {
            color: var(--brass-lt);
            text-decoration: none;
        }

            a:hover {
                color: var(--ivory);
            }

        code, .mono {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.82em;
        }

        /* ── Layout ──────────────────────────────────────────────────────────────── */
        #app {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Header */
        #header {
            background: var(--velvet-mid);
            border-bottom: 1px solid rgba(184,134,11,0.3);
            padding: 0 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            height: 60px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: var(--shadow-md);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            cursor: pointer;
            flex-shrink: 0;
        }

        .brand-logo {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--brass);
        }

        .brand-logo-fallback {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--brass);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            border: 2px solid var(--brass-lt);
            color: var(--velvet);
            font-weight: 700;
        }

        .brand-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--brass-lt);
            letter-spacing: 0.03em;
        }

            .brand-name span {
                color: var(--stone-lt);
                font-weight: 400;
            }

        .header-nav {
            display: flex;
            gap: 0.25rem;
            align-items: center;
            flex: 1;
            overflow-x: auto;
            scrollbar-width: none;
        }

            .header-nav::-webkit-scrollbar {
                display: none;
            }

        .nav-btn {
            background: none;
            border: none;
            color: var(--stone-lt);
            padding: 0.4rem 0.75rem;
            border-radius: var(--radius);
            cursor: pointer;
            font-size: 0.85rem;
            font-family: 'Inter', sans-serif;
            white-space: nowrap;
            transition: color var(--transition), background var(--transition);
        }

            .nav-btn:hover, .nav-btn.active {
                color: var(--ivory);
                background: rgba(255,255,255,0.07);
            }

            .nav-btn.active {
                color: var(--brass-lt);
            }

        .header-right {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-left: auto;
            flex-shrink: 0;
        }

        .user-badge {
            font-size: 0.78rem;
            color: var(--stone-lt);
            padding: 0.25rem 0.6rem;
            background: rgba(255,255,255,0.05);
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .role-pill {
            font-size: 0.68rem;
            padding: 0.15rem 0.5rem;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            font-weight: 600;
        }

        .role-admin {
            background: rgba(184,134,11,0.25);
            color: var(--brass-lt);
            border: 1px solid var(--brass);
        }

        .role-content_manager {
            background: rgba(45,122,79,0.25);
            color: #52c98a;
            border: 1px solid #2d7a4f;
        }

        .role-reader {
            background: rgba(255,255,255,0.08);
            color: var(--stone-lt);
            border: 1px solid rgba(255,255,255,0.15);
        }

        /* Main content */
        #main {
            flex: 1;
            padding: 1.5rem;
            max-width: 1100px;
            width: 100%;
            margin: 0 auto;
        }

        /* ── Forms & Inputs ──────────────────────────────────────────────────────── */
        .field {
            margin-bottom: 1rem;
        }

            .field label {
                display: block;
                font-size: 0.78rem;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                color: var(--stone-lt);
                margin-bottom: 0.35rem;
                font-weight: 500;
            }

        .field-required::after {
            content: ' *';
            color: var(--brass-lt);
        }

        input[type="text"],
        input[type="email"],
        input[type="password"],
        input[type="date"],
        select,
        textarea {
            width: 100%;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: var(--radius);
            color: var(--ivory);
            padding: 0.55rem 0.75rem;
            font-size: 0.9rem;
            font-family: 'Inter', sans-serif;
            transition: border-color var(--transition), box-shadow var(--transition);
        }

            input:focus, select:focus, textarea:focus {
                outline: none;
                border-color: var(--brass);
                box-shadow: 0 0 0 3px var(--brass-glow);
            }

        select {
            cursor: pointer;
        }

        textarea {
            resize: vertical;
            min-height: 80px;
        }

            input::placeholder, textarea::placeholder {
                color: var(--stone);
            }

        .fit-mode-active {
            background: var(--brass) !important;
            color: var(--velvet) !important;
            border-color: var(--brass-lt) !important;
        }

        /* ── Buttons ─────────────────────────────────────────────────────────────── */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.5rem 1.1rem;
            border-radius: var(--radius);
            border: none;
            cursor: pointer;
            font-size: 0.875rem;
            font-family: 'Inter', sans-serif;
            font-weight: 500;
            transition: all var(--transition);
            white-space: nowrap;
            text-decoration: none;
        }

            .btn:disabled {
                opacity: 0.45;
                cursor: not-allowed;
            }

        .btn-primary {
            background: var(--brass);
            color: var(--velvet);
        }

            .btn-primary:hover:not(:disabled) {
                background: var(--brass-lt);
                box-shadow: 0 0 12px var(--brass-glow);
            }

        .btn-secondary {
            background: rgba(255,255,255,0.08);
            color: var(--ivory);
            border: 1px solid rgba(255,255,255,0.15);
        }

            .btn-secondary:hover:not(:disabled) {
                background: rgba(255,255,255,0.13);
            }

        .btn-danger {
            background: rgba(192,57,43,0.2);
            color: #e74c3c;
            border: 1px solid rgba(192,57,43,0.4);
        }

            .btn-danger:hover:not(:disabled) {
                background: rgba(192,57,43,0.35);
            }

        .btn-ghost {
            background: none;
            color: var(--stone-lt);
            padding: 0.35rem 0.6rem;
        }

            .btn-ghost:hover {
                color: var(--ivory);
            }

        .btn-sm {
            padding: 0.3rem 0.7rem;
            font-size: 0.78rem;
        }

        .btn-lg {
            padding: 0.7rem 1.6rem;
            font-size: 1rem;
        }

        .btn-icon {
            padding: 0.4rem;
            width: 34px;
            height: 34px;
            justify-content: center;
        }

        /* ── Cards ───────────────────────────────────────────────────────────────── */
        .card {
            background: var(--velvet-mid);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 10px;
            padding: 1.25rem;
            box-shadow: var(--shadow-sm);
        }

        .card-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
        }

        .card + .card {
            margin-top: 0.75rem;
        }

        /* Master record card */
        .master-card {
            border-left: 3px solid var(--brass);
            transition: border-color var(--transition), box-shadow var(--transition);
            cursor: pointer;
        }

            .master-card:hover {
                border-left-color: var(--brass-lt);
                box-shadow: var(--shadow-md);
            }

            .master-card.expanded {
                border-left-color: var(--brass-lt);
            }

        .master-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--ivory);
        }

        .master-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem 1rem;
            margin-top: 0.3rem;
            font-size: 0.8rem;
            color: var(--stone-lt);
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        /* PDF children */
        .pdf-list {
            margin-top: 0.75rem;
            border-top: 1px solid rgba(255,255,255,0.07);
            padding-top: 0.75rem;
            display: none;
        }

            .pdf-list.open {
                display: block;
            }

        .pdf-row {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.6rem;
            border-radius: var(--radius);
            transition: background var(--transition);
            flex-wrap: wrap;
        }

            .pdf-row:hover {
                background: rgba(255,255,255,0.04);
            }

        .pdf-row-info {
            flex: 1;
            min-width: 120px;
        }

        .pdf-desc {
            font-size: 0.88rem;
            color: var(--ivory);
        }

        .pdf-key {
            font-size: 0.75rem;
            color: var(--stone-lt);
            margin-top: 0.1rem;
        }

        .pdf-actions {
            display: flex;
            gap: 0.3rem;
            flex-shrink: 0;
            flex-wrap: wrap;
        }

        /* ── Search bar ──────────────────────────────────────────────────────────── */
        .search-bar {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1.25rem;
            align-items: stretch;
        }

            .search-bar input {
                flex: 1;
                font-size: 1rem;
                padding: 0.65rem 1rem;
            }

            .search-bar .btn {
                padding: 0 1.25rem;
            }

        /* ── PDF Viewer ──────────────────────────────────────────────────────────── */
        #pdf-viewer-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15,12,10,0.95);
            z-index: 1000;
            display: none;
            flex-direction: column;
        }

            #pdf-viewer-overlay.open {
                display: flex;
            }

        .viewer-toolbar {
            background: var(--velvet-mid);
            border-bottom: 1px solid rgba(184,134,11,0.3);
            padding: 0.65rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-shrink: 0;
        }

        .viewer-title {
            flex: 1;
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.1rem;
            color: var(--ivory);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        #pdf-frame {
            flex: 1;
            border: none;
            background: #525659;
        }

        /* ── Modal ───────────────────────────────────────────────────────────────── */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(10,8,6,0.85);
            z-index: 500;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

            .modal-overlay.open {
                display: flex;
            }

        .modal {
            background: var(--velvet-mid);
            border: 1px solid rgba(184,134,11,0.25);
            border-radius: 12px;
            padding: 1.75rem;
            width: 100%;
            max-width: 520px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: var(--shadow-lg);
        }

        .modal-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            margin-bottom: 1.25rem;
            color: var(--brass-lt);
        }

        .modal-footer {
            display: flex;
            gap: 0.5rem;
            justify-content: flex-end;
            margin-top: 1.25rem;
            padding-top: 1rem;
            border-top: 1px solid rgba(255,255,255,0.08);
        }

        /* ── Login screen ────────────────────────────────────────────────────────── */
        #login-screen {
            display: none;
            min-height: 100vh;
            background: var(--velvet);
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

            #login-screen.open {
                display: flex;
            }

        .login-box {
            background: var(--velvet-mid);
            border: 1px solid rgba(184,134,11,0.2);
            border-radius: 14px;
            padding: 2.5rem 2rem;
            width: 100%;
            max-width: 400px;
            box-shadow: var(--shadow-lg);
        }

        .login-brand {
            text-align: center;
            margin-bottom: 2rem;
        }

        .login-logo {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--brass);
            margin-bottom: 0.75rem;
        }

        .login-logo-fallback {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: var(--brass);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: var(--velvet);
            font-weight: 700;
            margin: 0 auto 0.75rem;
            border: 3px solid var(--brass-lt);
        }

        .login-brand h1 {
            font-size: 1.7rem;
            color: var(--ivory);
        }

        .login-brand p {
            color: var(--stone-lt);
            font-size: 0.85rem;
            margin-top: 0.2rem;
        }

        .login-links {
            display: flex;
            justify-content: space-between;
            margin-top: 1rem;
            font-size: 0.8rem;
        }

            .login-links a {
                color: var(--stone-lt);
            }

                .login-links a:hover {
                    color: var(--brass-lt);
                }

        /* ── Alerts ──────────────────────────────────────────────────────────────── */
        .alert {
            padding: 0.65rem 0.9rem;
            border-radius: var(--radius);
            font-size: 0.85rem;
            margin-bottom: 0.75rem;
        }

        .alert-error {
            background: rgba(192,57,43,0.2);
            border: 1px solid rgba(192,57,43,0.4);
            color: #e8756a;
        }

        .alert-success {
            background: rgba(45,122,79,0.2);
            border: 1px solid rgba(45,122,79,0.4);
            color: #52c98a;
        }

        .alert-info {
            background: rgba(184,134,11,0.15);
            border: 1px solid rgba(184,134,11,0.3);
            color: var(--brass-lt);
        }

        /* ── Table ───────────────────────────────────────────────────────────────── */
        .tbl {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.875rem;
        }

            .tbl th {
                text-align: left;
                padding: 0.5rem 0.75rem;
                color: var(--stone-lt);
                font-size: 0.72rem;
                text-transform: uppercase;
                letter-spacing: 0.07em;
                border-bottom: 1px solid rgba(255,255,255,0.1);
                font-weight: 500;
            }

            .tbl td {
                padding: 0.55rem 0.75rem;
                border-bottom: 1px solid rgba(255,255,255,0.05);
                vertical-align: middle;
            }

            .tbl tr:hover td {
                background: rgba(255,255,255,0.03);
            }

        /* ── Tabs ────────────────────────────────────────────────────────────────── */
        .tabs {
            display: flex;
            gap: 0;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            margin-bottom: 1.25rem;
        }

        .tab {
            padding: 0.55rem 1.1rem;
            border: none;
            background: none;
            color: var(--stone-lt);
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            font-size: 0.875rem;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            transition: color var(--transition), border-color var(--transition);
        }

            .tab:hover {
                color: var(--ivory);
            }

            .tab.active {
                color: var(--brass-lt);
                border-bottom-color: var(--brass);
            }

        /* ── Playlist items ──────────────────────────────────────────────────────── */
        .playlist-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.6rem 0.75rem;
            background: rgba(255,255,255,0.03);
            border-radius: var(--radius);
            border: 1px solid rgba(255,255,255,0.06);
            margin-bottom: 0.4rem;
            cursor: pointer;
            transition: background var(--transition);
        }

            .playlist-item:hover {
                background: rgba(255,255,255,0.07);
            }

        .playlist-item-num {
            width: 24px;
            height: 24px;
            background: var(--brass-glow);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.72rem;
            color: var(--brass-lt);
            font-weight: 600;
            flex-shrink: 0;
        }

        /* ── Page sections ────────────────────────────────────────────────────────── */
        .page {
            display: none;
        }

            .page.active {
                display: block;
            }

        .page-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }

        .page-title {
            color: var(--brass-lt);
        }

        .page-subtitle {
            color: var(--stone-lt);
            font-size: 0.85rem;
            margin-top: 0.2rem;
        }

        /* ── Empty state ─────────────────────────────────────────────────────────── */
        .empty {
            text-align: center;
            padding: 3rem 1rem;
            color: var(--stone);
        }

        .empty-icon {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            opacity: 0.5;
        }

        .empty h3 {
            color: var(--stone-lt);
            margin-bottom: 0.4rem;
        }

        /* ── Loading spinner ─────────────────────────────────────────────────────── */
        .spinner {
            display: inline-block;
            width: 18px;
            height: 18px;
            border: 2px solid rgba(184,134,11,0.3);
            border-top-color: var(--brass);
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .loading-block {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 2rem;
            color: var(--stone-lt);
            font-size: 0.9rem;
        }

        /* ── File upload ─────────────────────────────────────────────────────────── */
        .file-drop {
            border: 2px dashed rgba(184,134,11,0.35);
            border-radius: var(--radius);
            padding: 1.5rem;
            text-align: center;
            cursor: pointer;
            transition: border-color var(--transition), background var(--transition);
            color: var(--stone-lt);
            font-size: 0.875rem;
        }

            .file-drop:hover, .file-drop.drag-over {
                border-color: var(--brass);
                background: var(--brass-glow);
                color: var(--ivory);
            }

        .file-name-display {
            margin-top: 0.4rem;
            font-size: 0.78rem;
            color: var(--brass-lt);
        }

        /* ── Responsive ──────────────────────────────────────────────────────────── */
        @media (max-width: 640px) {
            #main {
                padding: 0.75rem;
            }

            .brand-name span {
                display: none;
            }

            .user-badge {
                display: none;
            }

            .modal {
                padding: 1.25rem;
            }

            .login-box {
                padding: 1.5rem 1.25rem;
            }

            .pdf-actions {
                width: 100%;
                justify-content: flex-start;
            }
        }

        /* ── Brass accent line (signature element) ────────────────────────────────── */
        .brass-rule {
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--brass) 20%, var(--brass-lt) 50%, var(--brass) 80%, transparent);
            margin: 1.5rem 0;
            opacity: 0.5;
        }

        /* Upload progress */
        .progress-bar {
            height: 4px;
            background: rgba(255,255,255,0.1);
            border-radius: 2px;
            overflow: hidden;
            margin-top: 0.5rem;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--brass), var(--brass-lt));
            border-radius: 2px;
            transition: width 0.3s ease;
        }

        /* Section headings with brass left border */
        .section-heading {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1rem;
            color: var(--stone-lt);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-weight: 500;
            padding-left: 0.75rem;
            border-left: 2px solid var(--brass);
            margin-bottom: 0.75rem;
        }

        /* Toast notifications */
        #toast-container {
            position: fixed;
            bottom: 1.25rem;
            right: 1.25rem;
            z-index: 2000;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            max-width: 340px;
        }

        .toast {
            background: var(--velvet-mid);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: var(--radius);
            padding: 0.7rem 1rem;
            font-size: 0.85rem;
            box-shadow: var(--shadow-md);
            animation: slideIn 0.2s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .toast.success {
                border-left: 3px solid var(--success);
            }

            .toast.error {
                border-left: 3px solid var(--danger);
            }

            .toast.info {
                border-left: 3px solid var(--brass);
            }

        @keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        /* Grid for admin user list */
        .user-grid {
            display: grid;
            gap: 0.5rem;
        }
    </style>
</head>
<body>

    <!-- Login Screen -->
    <div id="login-screen">
        <div class="login-box">
            <div class="login-brand">
                <img src="https://yt3.ggpht.com/aCKQaHThvSKIXmcXERpY7ifeG_m1Lr_4Lo_Zmamlap73SQGXS1BCaBracVBLdcyZ-C-Dv_jK_aM=s600-c-k-c0x00ffffff-no-rj-rp-mo"
                     class="login-logo" alt="ChurchMouse"
                     onerror="this.style.display='none'; document.querySelector('.login-logo-fallback').style.display='flex'">
                <div class="login-logo-fallback" style="display:none">🎺</div>
                <h1>ChurchMouse Music</h1>
                <p>Sheet music library</p>
            </div>
            <div id="login-alert"></div>
            <div class="field">
                <label for="login-email" class="field-required">Email</label>
                <input type="email" id="login-email" autocomplete="email" placeholder="you@example.com">
            </div>
            <div class="field">
                <label for="login-password" class="field-required">Password</label>
                <input type="password" id="login-password" autocomplete="current-password" placeholder="••••••••">
            </div>
            <button class="btn btn-primary btn-lg" style="width:100%" id="login-btn" onclick="doLogin()">Sign In</button>
            <div class="login-links">
                <a href="#" onclick="showForgotModal()">Forgot password?</a>
                <a href="#" onclick="showChangePasswordModal()">Change password</a>
            </div>
        </div>
    </div>

    <!-- App Shell -->
    <div id="app" style="display:none">
        <header id="header">
            <div class="brand" onclick="navigate('search')">
                <img src="https://yt3.ggpht.com/aCKQaHThvSKIXmcXERpY7ifeG_m1Lr_4Lo_Zmamlap73SQGXS1BCaBracVBLdcyZ-C-Dv_jK_aM=s600-c-k-c0x00ffffff-no-rj-rp-mo"
                     class="brand-logo" alt="ChurchMouse"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
                <div class="brand-logo-fallback" style="display:none">🎺</div>
                <span class="brand-name">ChurchMouse <span>Music</span></span>
            </div>
            <nav class="header-nav" id="main-nav">
                <button class="nav-btn" data-page="search" onclick="navigate('search')">🔍 Search</button>
                <button class="nav-btn" data-page="playlists" onclick="navigate('playlists')">♪ Playlists</button>
                <button class="nav-btn" data-page="content" onclick="navigate('content')" id="nav-content" style="display:none">📁 Content</button>
                <button class="nav-btn" data-page="admin" onclick="navigate('admin')" id="nav-admin" style="display:none">⚙ Admin</button>
            </nav>
            <div class="header-right">
                <span class="user-badge" id="user-badge"></span>
                <span class="role-pill" id="role-pill"></span>
                <button class="btn btn-ghost btn-sm" onclick="doLogout()">Sign out</button>
            </div>
        </header>

        <main id="main">

            <!-- ── SEARCH PAGE ──────────────────────────────────────────────────── -->
            <div class="page active" id="page-search">
                <div class="page-header">
                    <div>
                        <h2 class="page-title">Find Music</h2>
                        <p class="page-subtitle">Search by title, composer, melody, keywords, or file name</p>
                    </div>
                </div>
                <div class="search-bar">
                    <input type="text" id="search-input" placeholder="e.g. Amazing Grace, Handel, trumpet in Bb…" autocomplete="off"
                           onkeydown="if(event.key==='Enter') doSearch()">
                    <button class="btn btn-primary" onclick="doSearch()">Search</button>
                </div>
                <div id="search-results"></div>
            </div>

            <!-- ── PLAYLISTS PAGE ───────────────────────────────────────────────── -->
            <div class="page" id="page-playlists">
                <div class="page-header">
                    <div>
                        <h2 class="page-title">Playlists</h2>
                        <p class="page-subtitle">Organise PDFs into sets for practice or performance</p>
                    </div>
                    <button class="btn btn-primary" onclick="showCreatePlaylistModal()">+ New Playlist</button>
                </div>
                <div class="tabs">
                    <button class="tab active" onclick="switchPlaylistTab('manage', this)">Manage</button>
                    <button class="tab" onclick="switchPlaylistTab('view', this)">View</button>
                </div>
                <div id="playlist-manage-panel">
                    <div id="playlist-list"></div>
                </div>
                <div id="playlist-view-panel" style="display:none">
                    <div id="playlist-view-content"></div>
                </div>
            </div>

            <!-- ── CONTENT MANAGEMENT PAGE ─────────────────────────────────────── -->
            <div class="page" id="page-content">
                <div class="page-header">
                    <div>
                        <h2 class="page-title">Content Management</h2>
                        <p class="page-subtitle">Add, edit, and organise sheet music records and PDFs</p>
                    </div>
                    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center">
                        <select id="content-sort-order" onchange="onContentSortChange()" style="width:auto">
                            <option value="title">Sort: Title</option>
                            <option value="created">Sort: Last Create</option>
                        </select>
                    </div>
                    <div>
                        <button class="btn btn-primary" onclick="showAddMasterModal()">+ New Song</button>
                        <!-- <button class="btn btn-primary" onclick="showUploadPdfModal()">↑ Upload PDF</button> -->
                    </div>
                </div>
                <div class="search-bar">
                    <input type="text" id="content-search-input" placeholder="Search by title, composer, melody, keywords, or file name…" autocomplete="off"
                           onkeydown="if(event.key==='Enter') doContentSearch()">
                    <button class="btn btn-primary" onclick="doContentSearch()">Search</button>
                    <button class="btn btn-secondary" onclick="clearContentSearch()">Clear</button>
                </div>
                <div id="content-list"></div>
                <div id="content-pagination" style="display:flex;justify-content:center;align-items:center;gap:1rem;margin-top:1.25rem"></div>
            </div>

            <!-- ── ADMIN PAGE ───────────────────────────────────────────────────── -->
            <div class="page" id="page-admin">
                <div class="page-header">
                    <div>
                        <h2 class="page-title">User Administration</h2>
                        <p class="page-subtitle">Manage user accounts and access</p>
                    </div>
                    <button class="btn btn-primary" onclick="showAddUserModal()">+ Add User</button>
                </div>
                <div id="admin-users-list"></div>
            </div>

        </main>
    </div>

    <!-- PDF Viewer Overlay -->
    <div id="pdf-viewer-overlay">
        <div class="viewer-toolbar">
            <button class="btn btn-ghost" onclick="closePdfViewer()">✕ Close</button>
            <span class="viewer-title" id="viewer-title"></span>
            <button class="btn btn-secondary btn-sm" id="fit-width-btn" onclick="setFitMode('width')">Fit Width</button>
            <button class="btn btn-secondary btn-sm" id="fit-page-btn" onclick="setFitMode('page')">Fit Page</button>
            <button class="btn btn-secondary btn-sm" onclick="zoomPdf(-0.2)">－</button>
            <button class="btn btn-secondary btn-sm" onclick="zoomPdf(0.2)">＋</button>
            <button class="btn btn-secondary btn-sm" id="contrast-btn" onclick="toggleContrast()">Boost Contrast</button>
            <button class="btn btn-secondary btn-sm" id="threshold-btn" onclick="toggleThreshold()">B&amp;W Threshold</button>
            <button class="btn btn-secondary btn-sm" id="thinline-btn" onclick="toggleThinLineEnhance()">Enhance Thin Lines</button>
            <button class="btn btn-secondary btn-sm" id="viewer-prev" onclick="viewerNavigate(-1)" style="display:none">← Prev</button>
            <button class="btn btn-secondary btn-sm" id="viewer-next" onclick="viewerNavigate(1)" style="display:none">Next →</button>
            <button class="btn btn-primary btn-sm" id="viewer-download" onclick="downloadCurrentPdf()">↓ Download</button>
        </div>
        <div id="pdf-frame" style="flex:1; overflow:auto; background:#525659; -webkit-overflow-scrolling:touch;">
            <div id="pdf-canvas-container" style="display:flex; flex-direction:column; align-items:center; gap:8px; padding:8px;"></div>
            <div id="pdf-loading" class="loading-block" style="display:none; justify-content:center"><span class="spinner"></span> Loading PDF…</div>
        </div>
    </div>


    <!-- Toast container -->
    <div id="toast-container"></div>

    <!-- ────────────────────────── MODALS ─────────────────────────────────────── -->
    <!-- Forgot Password -->
    <div class="modal-overlay" id="modal-forgot">
        <div class="modal">
            <h3 class="modal-title">Reset Password</h3>
            <div id="forgot-alert"></div>
            <div class="field">
                <label for="forgot-email" class="field-required">Email address</label>
                <input type="email" id="forgot-email" placeholder="your@email.com">
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeModal('modal-forgot')">Cancel</button>
                <button class="btn btn-primary" onclick="doForgotPassword()">Send reset link</button>
            </div>
        </div>
    </div>

    <!-- Change Password -->
    <div class="modal-overlay" id="modal-change-password">
        <div class="modal">
            <h3 class="modal-title">Change Password</h3>
            <div id="change-pw-alert"></div>
            <div class="field">
                <label for="cp-email" class="field-required">Email</label>
                <input type="email" id="cp-email" placeholder="your@email.com">
            </div>
            <div class="field">
                <label for="cp-current" class="field-required">Current Password</label>
                <input type="password" id="cp-current" placeholder="••••••••">
            </div>
            <div class="field">
                <label for="cp-new" class="field-required">New Password</label>
                <input type="password" id="cp-new" placeholder="at least 8 characters">
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeModal('modal-change-password')">Cancel</button>
                <button class="btn btn-primary" onclick="doChangePassword()">Update Password</button>
            </div>
        </div>
    </div>

    <!-- Add/Edit Master Record -->
    <div class="modal-overlay" id="modal-master">
        <div class="modal">
            <h3 class="modal-title" id="modal-master-title">Add Music Record</h3>
            <input type="hidden" id="master-edit-id">
            <div id="master-alert"></div>
            <div class="field">
                <label for="mf-title" class="field-required">Title</label>
                <input type="text" id="mf-title" placeholder="Song or piece title">
            </div>
            <div class="field">
                <label for="mf-composer">Composer</label>
                <input type="text" id="mf-composer" placeholder="Composer name">
            </div>
            <div class="field">
                <label for="mf-melody">Melody</label>
                <input type="text" id="mf-melody" placeholder="Melodic theme or motif">
            </div>
            <div class="field">
                <label for="mf-keywords">Keywords</label>
                <input type="text" id="mf-keywords" placeholder="Comma-separated tags">
            </div>
            <div class="field">
                <label for="mf-description">Description</label>
                <textarea id="mf-description" placeholder="Additional notes about this piece"></textarea>
            </div>
            <div class="field">
                <label for="mf-notes">Internal Notes</label>
                <textarea id="mf-notes" placeholder="Private notes (not shown in search)"></textarea>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeModal('modal-master')">Cancel</button>
                <button class="btn btn-primary" onclick="saveMaster()" id="save-master-btn">Save</button>
            </div>
        </div>
    </div>

    <!-- Upload PDF -->
    <div class="modal-overlay" id="modal-upload-pdf">
        <div class="modal">
            <h3 class="modal-title">Upload Sheet Music PDF</h3>
            <div id="upload-alert"></div>
            <!--<div class="field">
            <label class="field-required">Parent Record</label>-->
            <!--<div style="display:flex;gap:0.5rem">
                <select id="upload-master-id" style="flex:1">
                    <option value="">— Select or search —</option>
                </select>
            </div>-->
            <!--</div>-->

            <div class="field">
                <input type="hidden" id="upload-master-id">
            </div>
            <div class="field">
                <input type="text" disabled id="upload-master-title">
            </div>

            <div class="field">
                <label for="upload-desc" class="field-required">Description</label>
                <input type="text" id="upload-desc" placeholder="e.g. Lead sheet, SATB, SAT">
            </div>
            <div class="field">
                <label for="upload-key">Key Signature</label>
                <input type="text" id="upload-key" placeholder="e.g. C Major, G minor, Bflat Major">
            </div>
            <div class="field">
                <label class="field-required">PDF File (max 20 MB)</label>
                <div class="file-drop" id="file-drop-zone"
                     onclick="document.getElementById('pdf-file-input').click()"
                     ondragover="event.preventDefault(); this.classList.add('drag-over')"
                     ondragleave="this.classList.remove('drag-over')"
                     ondrop="handleFileDrop(event)">
                    📄 Click to choose PDF or drag &amp; drop here
                </div>
                <div class="file-name-display" id="chosen-file-name"></div>
                <input type="file" id="pdf-file-input" accept="application/pdf" style="display:none" onchange="handleFileSelect(this)">
            </div>
            <div class="progress-bar" id="upload-progress-bar" style="display:none">
                <div class="progress-fill" id="upload-progress-fill" style="width:0%"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeModal('modal-upload-pdf')">Cancel</button>
                <button class="btn btn-primary" onclick="doUploadPdf()" id="upload-btn">Upload</button>
            </div>
        </div>
    </div>

    <!-- Edit PDF Detail -->
    <div class="modal-overlay" id="modal-edit-pdf">
        <div class="modal">
            <h3 class="modal-title">Edit PDF Details</h3>
            <input type="hidden" id="edit-pdf-id">
            <div id="edit-pdf-alert"></div>
            <div class="field">
                <label for="epf-desc" class="field-required">Description</label>
                <input type="text" id="epf-desc">
            </div>
            <div class="field">
                <label for="epf-key">Key Signature</label>
                <input type="text" id="epf-key">
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeModal('modal-edit-pdf')">Cancel</button>
                <button class="btn btn-primary" onclick="saveEditPdf()">Save</button>
            </div>
        </div>
    </div>

    <!-- Add User (Admin) -->
    <div class="modal-overlay" id="modal-add-user">
        <div class="modal">
            <h3 class="modal-title" id="modal-user-title">Add User</h3>
            <input type="hidden" id="edit-user-id">
            <div id="user-alert"></div>
            <div class="field">
                <label for="uf-name" class="field-required">Full Name</label>
                <input type="text" id="uf-name" placeholder="Full name">
            </div>
            <div class="field" id="uf-email-field">
                <label for="uf-email" class="field-required">Email</label>
                <input type="email" id="uf-email" placeholder="user@example.com">
            </div>
            <div class="field">
                <label for="uf-role" class="field-required">Role</label>
                <select id="uf-role">
                    <option value="reader">Reader</option>
                    <option value="content_manager">Content Manager</option>
                    <option value="admin">Administrator</option>
                </select>
            </div>
            <div class="field" id="uf-password-field">
                <label for="uf-password" class="field-required">Password</label>
                <input type="password" id="uf-password" placeholder="Min 8 characters">
            </div>
            <div class="field" id="uf-active-field" style="display:none">
                <label for="uf-active">Status</label>
                <select id="uf-active">
                    <option value="1">Active</option>
                    <option value="0">Inactive</option>
                </select>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeModal('modal-add-user')">Cancel</button>
                <button class="btn btn-primary" onclick="saveUser()" id="save-user-btn">Save</button>
            </div>
        </div>
    </div>

    <!-- Admin Reset Password -->
    <div class="modal-overlay" id="modal-reset-user-pw">
        <div class="modal">
            <h3 class="modal-title">Reset User Password</h3>
            <input type="hidden" id="reset-user-id">
            <div id="reset-user-alert"></div>
            <p style="color:var(--stone-lt); font-size:0.875rem; margin-bottom:1rem">
                Enter a temporary password. The user will be notified by email.
            </p>
            <div class="field">
                <label for="reset-new-pw" class="field-required">New Password</label>
                <input type="password" id="reset-new-pw" placeholder="Min 8 characters">
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeModal('modal-reset-user-pw')">Cancel</button>
                <button class="btn btn-primary" onclick="doResetUserPassword()">Reset &amp; Notify</button>
            </div>
        </div>
    </div>

    <!-- Create/Edit Playlist -->
    <div class="modal-overlay" id="modal-playlist">
        <div class="modal">
            <h3 class="modal-title" id="modal-playlist-title">New Playlist</h3>
            <input type="hidden" id="playlist-edit-id">
            <div id="playlist-alert"></div>
            <div class="field">
                <label for="pl-title" class="field-required">Title</label>
                <input type="text" id="pl-title" placeholder="Playlist name">
            </div>
            <div class="field">
                <label for="pl-expires">Expires</label>
                <input type="date" id="pl-expires">
            </div>
            <div class="field" id="pl-public-field" style="display:none">
                <label for="pl-public">Visibility</label>
                <select id="pl-public">
                    <option value="0">Private (only me)</option>
                    <option value="1">Public (all users)</option>
                </select>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeModal('modal-playlist')">Cancel</button>
                <button class="btn btn-primary" onclick="savePlaylist()">Save</button>
            </div>
        </div>
    </div>

    <!-- Add to Playlist -->
    <div class="modal-overlay" id="modal-add-to-playlist">
        <div class="modal">
            <h3 class="modal-title">Add to Playlist</h3>
            <input type="hidden" id="atp-pdf-id">
            <input type="hidden" id="atp-default-desc">
            <div id="atp-alert"></div>
            <div class="field">
                <label for="atp-playlist">Select Playlist</label>
                <select id="atp-playlist">
                    <option value="">— Choose playlist —</option>
                </select>
            </div>
            <div class="field">
                <label for="atp-desc">Description (optional override)</label>
                <input type="text" id="atp-desc" placeholder="Leave blank to use PDF description">
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeModal('modal-add-to-playlist')">Cancel</button>
                <button class="btn btn-primary" onclick="doAddToPlaylist()">Add</button>
            </div>
        </div>
    </div>


    <!-- ═══════════════════════ APPLICATION JAVASCRIPT ═══════════════════════════ -->
    <script>
        'use strict';

        // Pagination state for Content Management
        let contentPage = 0;          // zero-based page index
        const CONTENT_PAGE_SIZE = 25; // records per page
        let contentTotal = 0;         // total record count from server

        // Search state for Content Management
        let contentSearchResults = null; // null = normal paginated mode; array = active search results



        //alert('NEW VERSION LOADED');
        //console.log('NEW VERSION LIVE');


        // ─── Config ───────────────────────────────────────────────────────────────────
        const API = '/.api';  // same-origin; adjust if hosting API on different subdomain

        // ─── State ────────────────────────────────────────────────────────────────────
        let authToken = localStorage.getItem('cm_token') || null;
        let authUser = JSON.parse(localStorage.getItem('cm_user') || 'null');
        let masterList = [];           // cached for upload dropdown
        let viewerQueue = [];          // playlist viewer queue
        let viewerIndex = 0;

        // ─── Startup ──────────────────────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
            const hash = window.location.hash;

            // ✅ Handle reset link first
            if (hash.startsWith('#reset')) {
                const query = hash.split('?')[1];
                const params = new URLSearchParams(query);
                const token = params.get('token');

                if (token) {
                    // ✅ IMPORTANT: clear any existing session
                    authToken = null;
                    authUser = null;
                    localStorage.removeItem('cm_token');
                    localStorage.removeItem('cm_user');

                    showResetScreen(token);
                    return;
                }
            }

            // ✅ Normal flow
            if (authToken && authUser) {
                showApp();
            } else {
                showLogin();
            }
        });

        window.addEventListener('hashchange', () => {
            const hash = window.location.hash;

            if (hash.startsWith('#reset')) {
                const query = hash.split('?')[1];
                const params = new URLSearchParams(query);
                const token = params.get('token');

                if (token) {
                    // Clear session
                    authToken = null;
                    authUser = null;
                    localStorage.removeItem('cm_token');
                    localStorage.removeItem('cm_user');

                    showResetScreen(token);
                }
            }
        });


        // ─── Auth ─────────────────────────────────────────────────────────────────────
        function showLogin() {
            document.getElementById('login-screen').classList.add('open');
            document.getElementById('app').style.display = 'none';
            document.getElementById('login-email').focus();
            document.getElementById('login-password').addEventListener('keydown', e => {
                if (e.key === 'Enter') doLogin();
            });
        }

        function showResetScreen(token) {
            const btn = document.getElementById('login-btn');

            // ✅ remove old handler
            btn.onclick = null;

            // Reuse login layout
            showLogin();

            // Change title + subtitle
            document.querySelector('.login-brand h1').textContent = 'Reset Password';
            document.querySelector('.login-brand p').textContent = 'Enter your new password';

            // Hide email field
            document.getElementById('login-email').style.display = 'none';

            // Update password label
            document.querySelector('label[for="login-password"]').textContent = 'New Password';

            // Update button
            btn.textContent = 'Reset Password';

            // ✅ NEW handler
            btn.onclick = async () => {
                const newPassword = document.getElementById('login-password').value;
                const alertEl = document.getElementById('login-alert');

                if (!newPassword || newPassword.length < 8) {
                    showAlert(alertEl, 'Password must be at least 8 characters.', 'error');
                    return;
                }

                btn.disabled = true;
                btn.textContent = 'Resetting...';
                alertEl.innerHTML = '';

                try {
                    await apiPost('/auth/reset-password', {
                        token,
                        newPassword
                    }, true);

                    showAlert(alertEl, 'Password reset successful. You can now log in.', 'success');

                    setTimeout(() => {
                        location.hash = '';
                        location.reload();
                    }, 2000);

                } catch (e) {
                    showAlert(alertEl, e.message || 'Reset failed.', 'error');
                    btn.disabled = false;
                    btn.textContent = 'Reset Password';
                }
            };
        }

        function showApp() {
            document.getElementById('login-screen').classList.remove('open');
            document.getElementById('app').style.display = 'flex';

            // Show role-gated nav items
            if (authUser.role === 'admin' || authUser.role === 'content_manager') {
                document.getElementById('nav-content').style.display = '';
            }
            if (authUser.role === 'admin') {
                document.getElementById('nav-admin').style.display = '';
            }

            document.getElementById('user-badge').textContent = authUser.name;
            const rp = document.getElementById('role-pill');
            rp.textContent = authUser.role.replace('_', ' ');
            rp.className = 'role-pill role-' + authUser.role;

            navigate('search');
        }

        async function doLogin() {
            const email = document.getElementById('login-email').value.trim();
            const password = document.getElementById('login-password').value;
            const alertEl = document.getElementById('login-alert');
            const btn = document.getElementById('login-btn');

            if (!email || !password) {
                showAlert(alertEl, 'Please enter your email and password.', 'error');
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Signing in…';
            alertEl.innerHTML = '';

            try {
                const data = await apiPost('/auth/login', { email, password }, true);
                authToken = data.token;
                authUser = data.user;
                localStorage.setItem('cm_token', authToken);
                localStorage.setItem('cm_user', JSON.stringify(authUser));
                document.getElementById('login-password').value = '';
                showApp();
            } catch (err) {
                showAlert(alertEl, err.message || 'Login failed.', 'error');
                btn.disabled = false;
                btn.textContent = 'Sign In';
            }
        }

        function doLogout() {
            authToken = null;
            authUser = null;
            localStorage.removeItem('cm_token');
            localStorage.removeItem('cm_user');
            location.reload();
        }

        // ─── Navigation ───────────────────────────────────────────────────────────────
        function navigate(page) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));

            const pageEl = document.getElementById('page-' + page);
            const navEl = document.querySelector(`[data-page="${page}"]`);
            if (pageEl) pageEl.classList.add('active');
            if (navEl) navEl.classList.add('active');

            // Lazy-load page data
            if (page === 'playlists') loadPlaylists();
            if (page === 'content') loadContentList();
            if (page === 'admin') loadAdminUsers();
        }

        function renderContentPagination() {
            const el = document.getElementById('content-pagination');
            const totalPages = Math.max(1, Math.ceil(contentTotal / CONTENT_PAGE_SIZE));
            const currentPage = contentPage + 1; // for display, 1-based

            if (contentTotal <= CONTENT_PAGE_SIZE) {
                el.innerHTML = ''; // hide pagination if everything fits on one page
                return;
            }

            el.innerHTML = `
                <button class="btn btn-secondary btn-sm" id="cp-prev" ${contentPage === 0 ? 'disabled' : ''}>← Prev</button>
                <span style="color:var(--stone-lt);font-size:0.85rem">
                    Page ${currentPage} of ${totalPages} &nbsp;(${contentTotal} records)
                </span>
                <button class="btn btn-secondary btn-sm" id="cp-next" ${currentPage >= totalPages ? 'disabled' : ''}>Next →</button>
            `;

            document.getElementById('cp-prev').onclick = () => {
                if (contentPage > 0) { contentPage--; loadContentList(); }
            };
            document.getElementById('cp-next').onclick = () => {
                if (currentPage < totalPages) { contentPage++; loadContentList(); }
            };
        }

        // ─── API helpers ──────────────────────────────────────────────────────────────
        async function apiFetch(path, options = {}) {
            const headers = { ...(options.headers || {}) };
            if (authToken) headers['Authorization'] = 'Bearer ' + authToken;
            if (options.json) {
                headers['Content-Type'] = 'application/json';
                options.body = JSON.stringify(options.json);
                delete options.json;
            }
            const res = await fetch(API + path, { ...options, headers });
            if (res.status === 401) { doLogout(); throw new Error('Session expired.'); }
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || `Request failed (${res.status})`);
            return data;
        }
        const apiGet = (path) => apiFetch(path);
        const apiPost = (path, body, noAuth) => {
            const headers = {};
            if (!noAuth && authToken) headers['Authorization'] = 'Bearer ' + authToken;
            headers['Content-Type'] = 'application/json';
            return fetch(API + path, { method: 'POST', headers, body: JSON.stringify(body) })
                .then(async r => {
                    const d = await r.json().catch(() => ({}));
                    if (!r.ok) throw new Error(d.error || 'Request failed');
                    return d;
                });
        };
        const apiPut = (path, body) => apiFetch(path, { method: 'PUT', json: body });
        const apiPatch = (path, body) => apiFetch(path, { method: 'PATCH', json: body });
        const apiDelete = (path) => apiFetch(path, { method: 'DELETE' });

        // ─── Toast ────────────────────────────────────────────────────────────────────
        function toast(msg, type = 'info', duration = 3500) {
            const el = document.createElement('div');
            el.className = `toast ${type}`;
            el.textContent = msg;
            document.getElementById('toast-container').appendChild(el);
            setTimeout(() => el.remove(), duration);
        }

        // ─── Alert helper ─────────────────────────────────────────────────────────────
        function showAlert(el, msg, type = 'info') {
            if (typeof el === 'string') el = document.getElementById(el);
            el.innerHTML = `<div class="alert alert-${type}">${msg}</div>`;
        }
        function clearAlert(el) {
            if (typeof el === 'string') el = document.getElementById(el);
            el.innerHTML = '';
        }

        // ─── Modal helpers ────────────────────────────────────────────────────────────
        function openModal(id) { document.getElementById(id).classList.add('open'); }
        function closeModal(id) { document.getElementById(id).classList.remove('open'); }

        // ─── Forgot Password ─────────────────────────────────────────────────────────
        function showForgotModal() {
            clearAlert('forgot-alert');
            document.getElementById('forgot-email').value = '';
            openModal('modal-forgot');
        }
        async function doForgotPassword() {
            const email = document.getElementById('forgot-email').value.trim();
            if (!email) { showAlert('forgot-alert', 'Email is required.', 'error'); return; }
            try {
                const d = await apiPost('/auth/forgot-password', { email }, true);
                showAlert('forgot-alert', d.message, 'success');
            } catch (e) { showAlert('forgot-alert', e.message, 'error'); }
        }

        // ─── Change Password ──────────────────────────────────────────────────────────
        function showChangePasswordModal() {
            clearAlert('change-pw-alert');
            ['cp-email', 'cp-current', 'cp-new'].forEach(id => document.getElementById(id).value = '');
            if (authUser) document.getElementById('cp-email').value = authUser.email;
            openModal('modal-change-password');
        }
        async function doChangePassword() {
            const currentPassword = document.getElementById('cp-current').value;
            const newPassword = document.getElementById('cp-new').value;
            if (!currentPassword || !newPassword) { showAlert('change-pw-alert', 'Both passwords required', 'error'); return; }
            try {
                const d = await apiFetch('/auth/change-password', { method: 'POST', json: { currentPassword, newPassword } });
                showAlert('change-pw-alert', d.message, 'success');
                setTimeout(() => closeModal('modal-change-password'), 2000);
            } catch (e) { showAlert('change-pw-alert', e.message, 'error'); }
        }

        // ═══════════════════════════════════════════════════════════════════════════════
        // SEARCH
        // ═══════════════════════════════════════════════════════════════════════════════
        async function doSearch() {
            const q = document.getElementById('search-input').value.trim();
            const el = document.getElementById('search-results');
            if (!q) { el.innerHTML = '<div class="alert alert-info">Enter a search term above.</div>'; return; }

            el.innerHTML = '<div class="loading-block"><span class="spinner"></span> Searching…</div>';
            try {
                const data = await apiGet('/search?q=' + encodeURIComponent(q));
                renderSearchResults(data.results || [], el);
            } catch (e) {
                el.innerHTML = `<div class="alert alert-error">${e.message}</div>`;
            }
        }

        function renderSearchResults(results, container) {
            if (!results.length) {
                container.innerHTML = `<div class="empty"><div class="empty-icon">🎵</div><h3>No results found</h3><p>Try different keywords or a composer name.</p></div>`;
                return;
            }

            container.innerHTML = results.map(m => `
                <div class="card master-card" id="master-${m.id}" onclick="toggleMaster('${m.id}')">
                  <div class="card-header">
                    <div style="flex:1">
                      <div class="master-title">${esc(m.title)}</div>
                      <div class="master-meta">
                        ${m.composer ? `<span class="meta-item">♪ ${esc(m.composer)}</span>` : ''}
                        ${m.melody ? `<span class="meta-item">~ ${esc(m.melody)}</span>` : ''}
                        ${m.keywords ? `<span class="meta-item">🏷 ${esc(m.keywords)}</span>` : ''}
                        <span class="meta-item" style="color:var(--brass-lt)">${m.pdfs?.length || 0} PDF${m.pdfs?.length !== 1 ? 's' : ''}</span>
                      </div>
                      ${m.description ? `<p style="font-size:0.8rem;color:var(--stone-lt);margin-top:0.3rem">${esc(m.description)}</p>` : ''}
                    </div>
                    <span style="color:var(--stone);font-size:1rem">▾</span>
                  </div>
                  <div class="pdf-list" id="pdfs-${m.id}">
                    ${renderPdfRows(m.pdfs || [], m.title)}
                  </div>
                </div>
              `).join('');
        }

        function renderPdfRows(pdfs, masterTitle) {
            if (!pdfs.length) return '<p style="color:var(--stone);font-size:0.82rem;padding:0.25rem 0">No PDFs uploaded yet.</p>';
            return pdfs.map(p => `
                <div class="pdf-row">
                  <div class="pdf-row-info">
                    <div class="pdf-desc">${esc(p.description)}</div>
                    ${p.key_signature ? `<div class="pdf-key">Key: ${esc(p.key_signature)}</div>` : ''}
                  </div>
                  <div class="pdf-actions">
                    <button class="btn btn-primary btn-sm" onclick="event.stopPropagation(); viewPdf('${p.id}','${esc(masterTitle)} – ${esc(p.description)}')">View</button>
                    <button class="btn btn-secondary btn-sm" onclick="event.stopPropagation(); downloadPdf('${p.id}','${esc(p.file_name)}')">↓</button>
                    <button class="btn btn-secondary btn-sm" onclick="event.stopPropagation(); showAddToPlaylistModal('${p.id}','${esc(p.description)}')">+ List</button>
                  </div>
                </div>
              `).join('');
        }

        function toggleMaster(id) {
            const card = document.getElementById('master-' + id);
            const pdfList = document.getElementById('pdfs-' + id);
            const isOpen = pdfList.classList.contains('open');
            pdfList.classList.toggle('open', !isOpen);
            card.classList.toggle('expanded', !isOpen);
        }

        // ═══════════════════════════════════════════════════════════════════════════════
        // PDF VIEWER
        // ═══════════════════════════════════════════════════════════════════════════════
        let currentPdfId = null;
        let currentPdfDoc = null;
        let currentZoom = 1.0;

        async function viewPdf(pdfId, title, queue, queueIdx) {
            currentPdfId = pdfId;
            viewerQueue = queue || [];
            viewerIndex = queueIdx != null ? queueIdx : -1;
            currentZoom = 1.0;
            fitMode = 'page'; // default each time viewer opens

            document.getElementById('viewer-title').textContent = title;
            document.getElementById('pdf-viewer-overlay').classList.add('open');
            document.body.style.overflow = 'hidden';
            updateFitModeButtons();

            const hasPrev = viewerQueue.length && viewerIndex > 0;
            const hasNext = viewerQueue.length && viewerIndex < viewerQueue.length - 1;
            document.getElementById('viewer-prev').style.display = hasPrev ? '' : 'none';
            document.getElementById('viewer-next').style.display = hasNext ? '' : 'none';

            await loadAndRenderPdf(pdfId);
        }

        function toggleContrast() {
            contrastBoostEnabled = !contrastBoostEnabled;
            document.getElementById('contrast-btn').classList.toggle('fit-mode-active', contrastBoostEnabled);
            renderAllPages();
        }

        async function loadAndRenderPdf(pdfId) {
            const container = document.getElementById('pdf-canvas-container');
            const loadingEl = document.getElementById('pdf-loading');
            container.innerHTML = '';
            loadingEl.style.display = 'flex';

            try {
                // Fetch with Authorization header (more reliable than query token)
                const res = await fetch(`${API}/pdf/${pdfId}/view`, {
                    headers: { 'Authorization': 'Bearer ' + authToken }
                });
                if (!res.ok) throw new Error('Failed to load PDF (' + res.status + ')');
                const arrayBuffer = await res.arrayBuffer();

                currentPdfDoc = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
                await renderAllPages();
            } catch (e) {
                container.innerHTML = `<div class="alert alert-error">${esc(e.message)}</div>`;
            } finally {
                loadingEl.style.display = 'none';
            }
        }

        let thinLineEnhanceEnabled = false;

        function toggleThinLineEnhance() {
            thinLineEnhanceEnabled = !thinLineEnhanceEnabled;
            document.getElementById('thinline-btn').classList.toggle('fit-mode-active', thinLineEnhanceEnabled);
            renderAllPages();
        }

        // Thickens/darkens faint thin lines by dilating dark pixels into their
        // immediate neighbors (up/down/left/right). This mimics what Adobe's
        // print-side "enhance thin lines" option does, but on-screen: it targets
        // hairline strokes that anti-aliasing has rendered too faint/thin to read
        // clearly, without visibly thickening solid text or fills.
        function applyThinLineEnhance(ctx, width, height) {
            const src = ctx.getImageData(0, 0, width, height);
            const srcData = src.data;
            const out = ctx.createImageData(width, height);
            const outData = out.data;

            const darkThreshold = 200; // luminance below this is treated as "ink"

            const lum = (x, y) => {
                const i = (y * width + x) * 4;
                return srcData[i] * 0.299 + srcData[i + 1] * 0.587 + srcData[i + 2] * 0.114;
            };

            for (let y = 0; y < height; y++) {
                for (let x = 0; x < width; x++) {
                    const i = (y * width + x) * 4;
                    let minLum = lum(x, y);

                    if (x > 0) minLum = Math.min(minLum, lum(x - 1, y));
                    if (x < width - 1) minLum = Math.min(minLum, lum(x + 1, y));
                    if (y > 0) minLum = Math.min(minLum, lum(x, y - 1));
                    if (y < height - 1) minLum = Math.min(minLum, lum(x, y + 1));

                    if (minLum < darkThreshold) {
                        outData[i] = Math.min(srcData[i], minLum);
                        outData[i + 1] = Math.min(srcData[i + 1], minLum);
                        outData[i + 2] = Math.min(srcData[i + 2], minLum);
                    } else {
                        outData[i] = srcData[i];
                        outData[i + 1] = srcData[i + 1];
                        outData[i + 2] = srcData[i + 2];
                    }
                    outData[i + 3] = srcData[i + 3];
                }
            }

            ctx.putImageData(out, 0, 0);
        }

        let thresholdEnabled = false;
        let thresholdValue = 128; // midpoint cutoff, 0–255. Lower = more stays white, higher = more becomes black

        function toggleThreshold() {
            thresholdEnabled = !thresholdEnabled;
            document.getElementById('threshold-btn').classList.toggle('fit-mode-active', thresholdEnabled);

            // Threshold and contrast-boost are mutually exclusive (threshold makes contrast moot)
            if (thresholdEnabled && contrastBoostEnabled) {
                contrastBoostEnabled = false;
                document.getElementById('contrast-btn').classList.remove('fit-mode-active');
            }

            renderAllPages();
        }

        function applyThreshold(ctx, width, height) {
            const imageData = ctx.getImageData(0, 0, width, height);
            const data = imageData.data;

            for (let i = 0; i < data.length; i += 4) {
                // Convert to greyscale luminance first (weighted average, matches human perception)
                const luminance = data[i] * 0.299 + data[i + 1] * 0.587 + data[i + 2] * 0.114;
                const value = luminance < thresholdValue ? 0 : 255;

                data[i] = data[i + 1] = data[i + 2] = value;
                // alpha (data[i+3]) untouched
            }

            ctx.putImageData(imageData, 0, 0);
        }

        // ─── Fit mode state ─────────────────────────────────────────────────────────
        let fitMode = 'width'; // 'width' | 'page'

        function setFitMode(mode) {
            fitMode = mode;
            updateFitModeButtons();
            renderAllPages();
        }

        function updateFitModeButtons() {
            document.getElementById('fit-width-btn').classList.toggle('fit-mode-active', fitMode === 'width');
            document.getElementById('fit-page-btn').classList.toggle('fit-mode-active', fitMode === 'page');
        }

        async function renderAllPages() {
            const container = document.getElementById('pdf-canvas-container');
            container.innerHTML = '';
            if (!currentPdfDoc) return;

            const frameEl = document.getElementById('pdf-frame');
            const viewerWidth = frameEl.clientWidth - 16;
            const viewerHeight = frameEl.clientHeight - 16;

            for (let pageNum = 1; pageNum <= currentPdfDoc.numPages; pageNum++) {
                const page = await currentPdfDoc.getPage(pageNum);
                const baseViewport = page.getViewport({ scale: 1 });

                let fitScale;
                if (fitMode === 'page') {
                    const widthScale = viewerWidth / baseViewport.width;
                    const heightScale = viewerHeight / baseViewport.height;
                    fitScale = Math.min(widthScale, heightScale) * currentZoom;
                } else {
                    fitScale = (viewerWidth / baseViewport.width) * currentZoom;
                }

                const viewport = page.getViewport({ scale: fitScale });

                const canvas = document.createElement('canvas');
                canvas.width = viewport.width;
                canvas.height = viewport.height;
                canvas.style.background = '#fff';
                canvas.style.boxShadow = '0 2px 8px rgba(0,0,0,0.4)';
                container.appendChild(canvas);

                const ctx = canvas.getContext('2d');
                await page.render({ canvasContext: ctx, viewport }).promise;

                if (thresholdEnabled) {
                    applyThreshold(ctx, canvas.width, canvas.height);
                } else if (contrastBoostEnabled) {
                    applyContrastBoost(ctx, canvas.width, canvas.height);
                }

                if (thinLineEnhanceEnabled) {
                    applyThinLineEnhance(ctx, canvas.width, canvas.height);
                }
            }
        }

        // ─── Contrast boost (post-process rendered page for crisper black/white) ─────
        let contrastBoostEnabled = false; // toggle as desired

        function applyContrastBoost(ctx, width, height) {
            const imageData = ctx.getImageData(0, 0, width, height);
            const data = imageData.data;

            const contrast = 1.6;    // >1 = more contrast. Try 1.3–2.0
            const brightness = 15;   // additive brightness boost. Try 10–30
            const midpoint = 128;

            for (let i = 0; i < data.length; i += 4) {
                data[i] = clamp((data[i] - midpoint) * contrast + midpoint + brightness);
                data[i + 1] = clamp((data[i + 1] - midpoint) * contrast + midpoint + brightness);
                data[i + 2] = clamp((data[i + 2] - midpoint) * contrast + midpoint + brightness);
            }

            ctx.putImageData(imageData, 0, 0);
        }

        function clamp(v) {
            return v < 0 ? 0 : v > 255 ? 255 : v;
        }



        function zoomPdf(delta) {
            currentZoom = Math.min(3, Math.max(0.4, currentZoom + delta));
            renderAllPages();
        }


        function closePdfViewer() {
            document.getElementById('pdf-viewer-overlay').classList.remove('open');
            document.getElementById('pdf-canvas-container').innerHTML = '';
            currentPdfDoc = null;
            document.body.style.overflow = '';
        }

        function viewerNavigate(dir) {
            const newIdx = viewerIndex + dir;
            if (newIdx < 0 || newIdx >= viewerQueue.length) return;
            const item = viewerQueue[newIdx];
            viewPdf(item.pdf_id, item.display_desc || item.pdf_desc, viewerQueue, newIdx);
        }

        function downloadCurrentPdf() {
            if (currentPdfId) downloadPdf(currentPdfId);
        }

        // ─── Swipe gestures for PDF viewer (prev/next) ─────────────────────────────────
        (function setupPdfSwipe() {
            const el = document.getElementById('pdf-frame');
            if (!el) return;

            let touchStartX = 0;
            let touchStartY = 0;
            let touchStartTime = 0;

            const SWIPE_MIN_DISTANCE = 60;   // px, minimum horizontal travel
            const SWIPE_MAX_VERTICAL = 75;   // px, ignore swipe if too much vertical drift (likely scrolling)
            const SWIPE_MAX_TIME = 600;      // ms, must be a quick gesture, not a slow drag

            el.addEventListener('touchstart', (e) => {
                if (e.touches.length !== 1) return; // ignore pinch-zoom gestures
                touchStartX = e.touches[0].clientX;
                touchStartY = e.touches[0].clientY;
                touchStartTime = Date.now();
            }, { passive: true });

            el.addEventListener('touchend', (e) => {
                if (!touchStartTime) return;
                const touch = e.changedTouches[0];
                const dx = touch.clientX - touchStartX;
                const dy = touch.clientY - touchStartY;
                const dt = Date.now() - touchStartTime;

                touchStartTime = 0;

                if (dt > SWIPE_MAX_TIME) return;
                if (Math.abs(dy) > SWIPE_MAX_VERTICAL) return;       // vertical scroll, not a swipe
                if (Math.abs(dx) < SWIPE_MIN_DISTANCE) return;       // too small

                if (dx < 0) {
                    viewerNavigate(1);   // swipe left → next
                } else {
                    viewerNavigate(-1);  // swipe right → prev
                }
            }, { passive: true });
        })();

        function downloadPdf(pdfId, fileName) {
            const a = document.createElement('a');
            a.href = `${API}/pdf/${pdfId}/download?token=${authToken}`;
            a.download = fileName || 'sheet_music.pdf';
            document.body.appendChild(a);
            a.click();
            a.remove();
        }

        // ═══════════════════════════════════════════════════════════════════════════════
        // CONTENT MANAGEMENT
        // ═══════════════════════════════════════════════════════════════════════════════
        const CONTENT_SORT_KEY = 'cm_content_sort_order';

        function getContentSortPreference() {
            return sessionStorage.getItem(CONTENT_SORT_KEY) || 'title';
        }

        function setContentSortPreference(value) {
            sessionStorage.setItem(CONTENT_SORT_KEY, value);
        }

        function sortMasterList(list, sortBy) {
            const sorted = [...list];
            if (sortBy === 'created') {
                sorted.sort((a, b) => b.created_at - a.created_at);
            } else {
                sorted.sort((a, b) =>
                    a.title.localeCompare(b.title, undefined, { numeric: true, sensitivity: 'base' })
                );
            }
            return sorted;
        }

        /*  function onContentSortChange() {
              const sortBy = document.getElementById('content-sort-order').value;
              setContentSortPreference(sortBy);
              renderContentList(sortMasterList(masterList, sortBy), document.getElementById('content-list'));
          } */

        async function loadContentList() {
            const el = document.getElementById('content-list');

            // If a content search is active, render those results instead of the
            // normal paginated master list.
            if (contentSearchResults !== null) {
                renderContentSearchResults(contentSearchResults, el);
                document.getElementById('content-pagination').innerHTML = '';
                return;
            }

            el.innerHTML = '<div class="loading-block"><span class="spinner"></span> Loading…</div>';

            const sortBy = getContentSortPreference();
            document.getElementById('content-sort-order').value = sortBy;

            const offset = contentPage * CONTENT_PAGE_SIZE;

            try {
                const data = await apiGet(`/master?limit=${CONTENT_PAGE_SIZE}&offset=${offset}&sort=${sortBy}`);
                masterList = data.results || [];
                contentTotal = data.total || 0;
                renderContentList(masterList, el);
                renderContentPagination();
            } catch (e) {
                el.innerHTML = `<div class="alert alert-error">${e.message}</div>`;
            }
        }

        function onContentSortChange() {
            const sortBy = document.getElementById('content-sort-order').value;
            setContentSortPreference(sortBy);
            contentPage = 0; // reset to first page on sort change
            loadContentList();
        }

        // Re-renders whichever view is currently active (search results or the
        // normal paginated list) — used after create/update/delete actions.
        function refreshContentView() {
            if (contentSearchResults !== null) {
                doContentSearch();
            } else {
                loadContentList();
            }
        }

        // ── Content Management search ────────────────────────────────────────────────
        async function doContentSearch() {
            const q = document.getElementById('content-search-input').value.trim();
            const el = document.getElementById('content-list');

            if (!q) {
                clearContentSearch();
                return;
            }

            el.innerHTML = '<div class="loading-block"><span class="spinner"></span> Searching…</div>';
            document.getElementById('content-pagination').innerHTML = '';

            try {
                const data = await apiGet('/search?q=' + encodeURIComponent(q));
                contentSearchResults = data.results || [];
                renderContentSearchResults(contentSearchResults, el);
            } catch (e) {
                el.innerHTML = `<div class="alert alert-error">${e.message}</div>`;
            }
        }

        function clearContentSearch() {
            contentSearchResults = null;
            document.getElementById('content-search-input').value = '';
            contentPage = 0;
            loadContentList();
        }

        function renderContentSearchResults(list, container) {
            const q = document.getElementById('content-search-input').value.trim();
            const header = `
                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;margin-bottom:0.75rem">
                  <span style="color:var(--stone-lt);font-size:0.85rem">${list.length} result${list.length !== 1 ? 's' : ''} for "${esc(q)}"</span>
                  <button class="btn btn-secondary btn-sm" onclick="clearContentSearch()">✕ Clear search</button>
                </div>`;

            if (!list.length) {
                container.innerHTML = header + `<div class="empty"><div class="empty-icon">🔍</div><h3>No matches</h3><p>Try different keywords or a composer name.</p></div>`;
                return;
            }

            container.innerHTML = header + list.map(m => `
                <div class="card master-card" id="cs-card-${m.id}">
                  <div class="card-header" onclick="toggleSearchMaster('${m.id}')" style="cursor:pointer">
                    <div style="flex:1">
                      <div class="master-title">${esc(m.title)}</div>
                      <div class="master-meta">
                        ${m.composer ? `<span class="meta-item">♪ ${esc(m.composer)}</span>` : ''}
                        <span class="meta-item" style="color:var(--brass-lt)">${m.pdfs?.length || 0} PDF${m.pdfs?.length !== 1 ? 's' : ''}</span>
                      </div>
                    </div>
                    <div style="display:flex;gap:0.4rem" onclick="event.stopPropagation()">
                      <button class="btn btn-secondary btn-sm" onclick="editMaster('${m.id}')">Edit</button>
                      <button class="btn btn-danger btn-sm"    onclick="deleteMaster('${m.id}','${esc(m.title)}')">Delete</button>
                    </div>
                  </div>
                  <div class="pdf-list" id="cs-pdfs-${m.id}">
                    ${renderCMPdfRows(m.pdfs || [])}
                    <div style="margin-top:0.5rem">
                      <button class="btn btn-primary btn-sm" onclick="event.stopPropagation(); prepareUploadForMaster('${m.id}','${esc(m.title)}')">↑ Upload PDF</button>
                    </div>
                  </div>
                </div>
              `).join('');
        }

        function toggleSearchMaster(id) {
            const card = document.getElementById('cs-card-' + id);
            const pdfList = document.getElementById('cs-pdfs-' + id);
            const isOpen = pdfList.classList.contains('open');
            pdfList.classList.toggle('open', !isOpen);
            card.classList.toggle('expanded', !isOpen);
        }


        function renderContentList(list, container) {
            if (!list.length) {
                container.innerHTML = `<div class="empty"><div class="empty-icon">📁</div><h3>No records yet</h3><p>Add your first master record, then upload a PDF.</p></div>`;
                return;
            }
            container.innerHTML = list.map(m => `
                <div class="card master-card" onclick="toggleMasterContent('${m.id}','${esc(m.title)}')">
                  <div class="card-header">
                    <div style="flex:1">
                      <div class="master-title">${esc(m.title)}</div>
                      <div class="master-meta">
                        ${m.composer ? `<span class="meta-item">♪ ${esc(m.composer)}</span>` : ''}
                        <span class="meta-item" style="color:var(--brass-lt)">${m.pdf_count || 0} PDF${m.pdf_count !== 1 ? 's' : ''}</span>
                      </div>
                    </div>
                    <div style="display:flex;gap:0.4rem" onclick="event.stopPropagation()">
                      <button class="btn btn-secondary btn-sm" onclick="editMaster('${m.id}')">Edit</button>
                      <button class="btn btn-danger btn-sm"    onclick="deleteMaster('${m.id}','${esc(m.title)}')">Delete</button>
                    </div>
                  </div>
                  <div class="pdf-list" id="cm-pdfs-${m.id}">
                    <div class="loading-block" style="padding:0.5rem"><span class="spinner"></span></div>
                  </div>
                </div>
              `).join('');
        }

        async function toggleMasterContent(id, title) {
            const card = document.getElementById('cm-pdfs-' + id)?.closest('.master-card');
            const pdfList = document.getElementById('cm-pdfs-' + id);
            if (!pdfList) return;
            const isOpen = pdfList.classList.contains('open');
            if (!isOpen) {
                pdfList.classList.add('open');
                card?.classList.add('expanded');
                // Fetch children
                try {
                    const m = await apiGet('/master/' + id);
                    pdfList.innerHTML = renderCMPdfRows(m.pdfs || []) +
                        `<div style="margin-top:0.5rem">
                       <button class="btn btn-primary btn-sm" onclick="event.stopPropagation(); prepareUploadForMaster('${m.id}','${m.title}')">↑ Upload PDF</button>
                     </div>`;
                } catch (e) {
                    pdfList.innerHTML = `<div class="alert alert-error">${e.message}</div>`;
                }
            } else {
                pdfList.classList.remove('open');
                card?.classList.remove('expanded');
            }
        }

        function renderCMPdfRows(pdfs) {
            if (!pdfs.length) return '<p style="color:var(--stone);font-size:0.82rem;padding:0.25rem 0">No PDFs yet.</p>';
            return pdfs.map(p => `
                <div class="pdf-row">
                  <div class="pdf-row-info">
                    <div class="pdf-desc">${esc(p.description)}</div>
                    ${p.key_signature ? `<div class="pdf-key">Key: ${esc(p.key_signature)}</div>` : ''}
                    <div class="pdf-key mono">${esc(p.file_name)}</div>
                  </div>
                  <div class="pdf-actions">
                    <button class="btn btn-secondary btn-sm" onclick="event.stopPropagation(); viewPdf('${p.id}','${esc(p.description)}')">View</button>
                    <button class="btn btn-secondary btn-sm" onclick="event.stopPropagation(); showEditPdfModal('${p.id}','${esc(p.description)}','${esc(p.key_signature || '')}')">Edit</button>
                    <button class="btn btn-danger btn-sm"    onclick="event.stopPropagation(); deletePdf('${p.id}','${esc(p.description)}')">Del</button>
                  </div>
                </div>
              `).join('');
        }

        // ── Master CRUD ───────────────────────────────────────────────────────────────
        function showAddMasterModal(forUpload = false) {
            document.getElementById('modal-master-title').textContent = 'Add Music Record';
            document.getElementById('master-edit-id').value = '';
            ['mf-title', 'mf-composer', 'mf-melody', 'mf-keywords', 'mf-description', 'mf-notes']
                .forEach(id => document.getElementById(id).value = '');
            clearAlert('master-alert');
            openModal('modal-master');
            window._masterForUpload = forUpload;
        }

        async function editMaster(id) {
            try {
                const m = await apiGet('/master/' + id);
                document.getElementById('modal-master-title').textContent = 'Edit Music Record';
                document.getElementById('master-edit-id').value = m.id;
                document.getElementById('mf-title').value = m.title || '';
                document.getElementById('mf-composer').value = m.composer || '';
                document.getElementById('mf-melody').value = m.melody || '';
                document.getElementById('mf-keywords').value = m.keywords || '';
                document.getElementById('mf-description').value = m.description || '';
                document.getElementById('mf-notes').value = m.notes || '';
                clearAlert('master-alert');
                openModal('modal-master');
            } catch (e) { toast(e.message, 'error'); }
        }

        async function saveMaster() {
            const id = document.getElementById('master-edit-id').value;
            const body = {
                title: document.getElementById('mf-title').value.trim(),
                composer: document.getElementById('mf-composer').value.trim(),
                melody: document.getElementById('mf-melody').value.trim(),
                keywords: document.getElementById('mf-keywords').value.trim(),
                description: document.getElementById('mf-description').value.trim(),
                notes: document.getElementById('mf-notes').value.trim(),
            };
            if (!body.title) { showAlert('master-alert', 'Title is required.', 'error'); return; }

            const btn = document.getElementById('save-master-btn');
            btn.disabled = true; btn.textContent = 'Saving…';
            try {
                let saved;
                if (id) {
                    await apiPut('/master/' + id, body);
                    saved = id;
                } else {
                    const d = await apiFetch('/master', { method: 'POST', json: body });
                    saved = d.id;
                }
                toast(id ? 'Record updated.' : 'Record created.', 'success');
                closeModal('modal-master');
                if (window._masterForUpload) {
                    // await loadMasterDropdown();
                    document.getElementById('upload-master-id').value = saved;
                    openModal('modal-upload-pdf');
                } else {
                    refreshContentView();
                }
            } catch (e) { showAlert('master-alert', e.message, 'error'); }
            finally { btn.disabled = false; btn.textContent = 'Save'; }
        }

        async function deleteMaster(id, title) {
            if (!confirm(`Delete "${title}" and ALL its PDFs? This cannot be undone.`)) return;
            try {
                await apiDelete('/master/' + id);
                toast('Record deleted.', 'success');
                refreshContentView();
            } catch (e) { toast(e.message, 'error'); }
        }

        // ── PDF Upload ────────────────────────────────────────────────────────────────
        let selectedFile = null;

        async function loadMasterDropdown() {
            const sel = document.getElementById('upload-master-id');
            const sortBy = getContentSortPreference();

            try {
                //const data = await apiGet(`/master?limit=${CONTENT_PAGE_SIZE}&offset=${offset}&sort=${sortBy}`);
                const data = await apiGet('/master?limit=500');
                masterList = data.results || [];
                sel.innerHTML = '<option value="">— Select master record —</option>' +
                    masterList.map(m => `<option value="${m.id}">${esc(m.title)}${m.composer ? ' — ' + esc(m.composer) : ''}</option>`).join('');
            } catch (e) { /* silent */ }
        }

        async function showUploadPdfModal() {
            selectedFile = null;
            document.getElementById('chosen-file-name').textContent = '';
            document.getElementById('pdf-file-input').value = '';
            ['upload-desc', 'upload-key'].forEach(id => document.getElementById(id).value = '');
            document.getElementById('upload-progress-bar').style.display = 'none';
            clearAlert('upload-alert');
            //await loadMasterDropdown();
            openModal('modal-upload-pdf');
        }

        function prepareUploadForMaster(masterId, masterTitle) {
            //console.log ("Title = ", masterTitle)
            showUploadPdfModal().then(() => {
                document.getElementById('upload-master-id').value = masterId;
                document.getElementById('upload-master-title').value = masterTitle;
            });
        }

        function handleFileSelect(input) {
            selectedFile = input.files[0] || null;
            document.getElementById('chosen-file-name').textContent = selectedFile ? selectedFile.name : '';
        }

        function handleFileDrop(event) {
            event.preventDefault();
            document.getElementById('file-drop-zone').classList.remove('drag-over');
            const file = event.dataTransfer.files[0];
            if (file && file.type === 'application/pdf') {
                selectedFile = file;
                document.getElementById('chosen-file-name').textContent = file.name;
            } else {
                toast('Only PDF files are accepted.', 'error');
            }
        }

        async function doUploadPdf() {
            const masterId = document.getElementById('upload-master-id').value;
            const description = document.getElementById('upload-desc').value.trim();
            const keySignature = document.getElementById('upload-key').value.trim();

            if (!masterId) { showAlert('upload-alert', 'Please select a master record.', 'error'); return; }
            if (!description) { showAlert('upload-alert', 'Description is required.', 'error'); return; }
            if (!selectedFile) { showAlert('upload-alert', 'Please choose a PDF file.', 'error'); return; }

            const btn = document.getElementById('upload-btn');
            btn.disabled = true;
            const progressBar = document.getElementById('upload-progress-bar');
            const progressFill = document.getElementById('upload-progress-fill');
            progressBar.style.display = '';
            progressFill.style.width = '20%';

            const fd = new FormData();
            fd.append('master_id', masterId);
            fd.append('description', description);
            fd.append('key_signature', keySignature);
            fd.append('file', selectedFile);

            try {
                progressFill.style.width = '50%';
                const res = await fetch(API + '/pdf', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + authToken },
                    body: fd
                });
                progressFill.style.width = '90%';
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Upload failed');
                progressFill.style.width = '100%';
                setTimeout(() => {
                    toast('PDF uploaded successfully.', 'success');
                    closeModal('modal-upload-pdf');
                    refreshContentView();
                }, 300);
            } catch (e) {
                showAlert('upload-alert', e.message, 'error');
                progressBar.style.display = 'none';
            } finally {
                btn.disabled = false;
            }
        }

        // ── Edit PDF Detail ───────────────────────────────────────────────────────────
        function showEditPdfModal(id, desc, key) {
            document.getElementById('edit-pdf-id').value = id;
            document.getElementById('epf-desc').value = desc;
            document.getElementById('epf-key').value = key;
            clearAlert('edit-pdf-alert');
            openModal('modal-edit-pdf');
        }

        async function saveEditPdf() {
            const id = document.getElementById('edit-pdf-id').value;
            const desc = document.getElementById('epf-desc').value.trim();
            const key = document.getElementById('epf-key').value.trim();
            if (!desc) { showAlert('edit-pdf-alert', 'Description is required.', 'error'); return; }
            try {
                await apiPut('/pdf/' + id, { description: desc, key_signature: key });
                toast('PDF details updated.', 'success');
                closeModal('modal-edit-pdf');
                refreshContentView();
            } catch (e) { showAlert('edit-pdf-alert', e.message, 'error'); }
        }

        async function deletePdf(id, desc) {
            if (!confirm(`Delete PDF "${desc}"? This cannot be undone.`)) return;
            try {
                await apiDelete('/pdf/' + id);
                toast('PDF deleted.', 'success');
                refreshContentView();
            } catch (e) { toast(e.message, 'error'); }
        }

        // ═══════════════════════════════════════════════════════════════════════════════
        // PLAYLISTS
        // ═══════════════════════════════════════════════════════════════════════════════
        let playlists = [];

        async function loadPlaylists() {
            const el = document.getElementById('playlist-list');
            el.innerHTML = '<div class="loading-block"><span class="spinner"></span> Loading playlists…</div>';
            try {
                playlists = await apiGet('/playlists');
                renderPlaylistManage(playlists);
            } catch (e) {
                el.innerHTML = `<div class="alert alert-error">${e.message}</div>`;
            }
        }

        function switchPlaylistTab(tab, btn) {
            document.querySelectorAll('.tabs .tab').forEach(t => t.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('playlist-manage-panel').style.display = tab === 'manage' ? '' : 'none';
            document.getElementById('playlist-view-panel').style.display = tab === 'view' ? '' : 'none';
            if (tab === 'view') renderPlaylistView(playlists);
        }

        function renderPlaylistManage(list) {
            const el = document.getElementById('playlist-list');
            if (!list.length) {
                el.innerHTML = `<div class="empty"><div class="empty-icon">♪</div><h3>No playlists yet</h3><p>Create one to organise your sheet music.</p></div>`;
                return;
            }
            el.innerHTML = list.map(pl => `
                <div class="card" style="margin-bottom:0.5rem">
                  <div class="card-header">
                    <div>
                      <strong style="font-family:'Cormorant Garamond',serif;font-size:1.1rem">${esc(pl.title)}</strong>
                      <div class="master-meta">
                        <span class="meta-item">${pl.item_count} item${pl.item_count !== 1 ? 's' : ''}</span>
                        ${pl.is_public ? '<span class="meta-item" style="color:var(--brass-lt)">Public</span>' : '<span class="meta-item">Private</span>'}
                        <span class="meta-item">Expires ${new Date(pl.expires_at * 1000).toLocaleDateString()}</span>
                      </div>
                    </div>
                    <div style="display:flex;gap:0.4rem;flex-wrap:wrap">
                      <button class="btn btn-secondary btn-sm" onclick="viewPlaylist('${pl.id}')">View</button>
                      <button class="btn btn-secondary btn-sm" onclick="editPlaylist('${pl.id}')">Edit</button>
                      <button class="btn btn-danger btn-sm"    onclick="deletePlaylist('${pl.id}','${esc(pl.title)}')">Delete</button>
                    </div>
                  </div>
                </div>
              `).join('');
        }

        function renderPlaylistView(list) {
            const el = document.getElementById('playlist-view-content');
            if (!list.length) {
                el.innerHTML = `<div class="empty"><div class="empty-icon">♪</div><h3>No playlists</h3></div>`;
                return;
            }
            el.innerHTML = list.map(pl => `
                <div class="card" style="margin-bottom:0.5rem;cursor:pointer" onclick="viewPlaylist('${pl.id}')">
                  <strong style="font-family:'Cormorant Garamond',serif">${esc(pl.title)}</strong>
                  <div class="master-meta">
                    <span>${pl.item_count} item${pl.item_count !== 1 ? 's' : ''}</span>
                    ${pl.is_public ? '<span style="color:var(--brass-lt)">Public</span>' : '<span>Private</span>'}
                  </div>
                </div>
              `).join('');
        }

        async function viewPlaylist(id) {
            try {
                const pl = await apiGet('/playlists/' + id);
                // Open a full-screen playlist view in a modal-like overlay
                const items = pl.items || [];
                const queue = items.map(item => ({
                    pdf_id: item.pdf_id,
                    display_desc: `${item.master_title} — ${item.display_desc || item.pdf_desc}`
                }));

                if (!items.length) { toast('This playlist is empty.', 'info'); return; }
                viewPdf(queue[0].pdf_id, queue[0].display_desc, queue, 0);
            } catch (e) { toast(e.message, 'error'); }
        }

        function showCreatePlaylistModal() {
            document.getElementById('modal-playlist-title').textContent = 'New Playlist';
            document.getElementById('playlist-edit-id').value = '';
            document.getElementById('pl-title').value = '';
            const tomorrow3 = new Date(Date.now() + 3 * 86400000);
            document.getElementById('pl-expires').value = tomorrow3.toISOString().split('T')[0];
            document.getElementById('pl-public').value = '0';
            if (authUser.role === 'admin' || authUser.role === 'content_manager') {
                document.getElementById('pl-public-field').style.display = '';
            }
            clearAlert('playlist-alert');
            openModal('modal-playlist');
        }

        async function editPlaylist(id) {
            const pl = playlists.find(p => p.id === id);
            if (!pl) return;
            document.getElementById('modal-playlist-title').textContent = 'Edit Playlist';
            document.getElementById('playlist-edit-id').value = pl.id;
            document.getElementById('pl-title').value = pl.title;
            document.getElementById('pl-expires').value = new Date(pl.expires_at * 1000).toISOString().split('T')[0];
            document.getElementById('pl-public').value = pl.is_public ? '1' : '0';
            if (authUser.role === 'admin' || authUser.role === 'content_manager') {
                document.getElementById('pl-public-field').style.display = '';
            }
            clearAlert('playlist-alert');
            openModal('modal-playlist');
        }

        async function savePlaylist() {
            const id = document.getElementById('playlist-edit-id').value;
            const title = document.getElementById('pl-title').value.trim();
            const expires = document.getElementById('pl-expires').value;
            const pub = parseInt(document.getElementById('pl-public').value);

            if (!title) { showAlert('playlist-alert', 'Title is required.', 'error'); return; }
            if (!expires) { showAlert('playlist-alert', 'Expiry date is required.', 'error'); return; }

            const expires_at = Math.floor(new Date(expires).getTime() / 1000) + 86399; // end of day
            const body = { title, is_public: pub, expires_at };

            try {
                if (id) {
                    await apiPut('/playlists/' + id, body);
                    toast('Playlist updated.', 'success');
                } else {
                    await apiFetch('/playlists', { method: 'POST', json: body });
                    toast('Playlist created.', 'success');
                }
                closeModal('modal-playlist');
                loadPlaylists();
            } catch (e) { showAlert('playlist-alert', e.message, 'error'); }
        }

        async function deletePlaylist(id, title) {
            if (!confirm(`Delete playlist "${title}"?`)) return;
            try {
                await apiDelete('/playlists/' + id);
                toast('Playlist deleted.', 'success');
                loadPlaylists();
            } catch (e) { toast(e.message, 'error'); }
        }

        // ── Add to Playlist ───────────────────────────────────────────────────────────
        async function showAddToPlaylistModal(pdfId, defaultDesc) {
            document.getElementById('atp-pdf-id').value = pdfId;
            document.getElementById('atp-default-desc').value = defaultDesc;
            document.getElementById('atp-desc').value = '';
            clearAlert('atp-alert');

            // Load user's playlists
            try {
                const list = await apiGet('/playlists');
                const sel = document.getElementById('atp-playlist');
                sel.innerHTML = '<option value="">— Choose playlist —</option>' +
                    list.map(pl => `<option value="${pl.id}">${esc(pl.title)}</option>`).join('');
            } catch (e) { /* silent */ }

            openModal('modal-add-to-playlist');
        }

        async function doAddToPlaylist() {
            const playlistId = document.getElementById('atp-playlist').value;
            const pdfId = document.getElementById('atp-pdf-id').value;
            const desc = document.getElementById('atp-desc').value.trim() ||
                document.getElementById('atp-default-desc').value;

            if (!playlistId) { showAlert('atp-alert', 'Please select a playlist.', 'error'); return; }

            try {
                await apiFetch('/playlists/' + playlistId + '/items', {
                    method: 'POST', json: { pdf_detail_id: pdfId, display_desc: desc }
                });
                toast('Added to playlist.', 'success');
                closeModal('modal-add-to-playlist');
            } catch (e) { showAlert('atp-alert', e.message, 'error'); }
        }

        // ═══════════════════════════════════════════════════════════════════════════════
        // ADMIN – USERS
        // ═══════════════════════════════════════════════════════════════════════════════
        let allUsers = [];

        async function loadAdminUsers() {
            const el = document.getElementById('admin-users-list');
            el.innerHTML = '<div class="loading-block"><span class="spinner"></span> Loading users…</div>';
            try {
                allUsers = await apiGet('/users');
                renderAdminUsers(allUsers);
            } catch (e) {
                el.innerHTML = `<div class="alert alert-error">${e.message}</div>`;
            }
        }

        function renderAdminUsers(users) {
            const el = document.getElementById('admin-users-list');
            if (!users.length) {
                el.innerHTML = '<div class="empty"><h3>No users found</h3></div>';
                return;
            }
            el.innerHTML = `
                <div style="overflow-x:auto">
                  <table class="tbl">
                    <thead>
                      <tr>
                        <th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      ${users.map(u => `
                        <tr>
                          <td>${esc(u.name)}</td>
                          <td style="color:var(--stone-lt);font-size:0.82rem">${esc(u.email)}</td>
                          <td><span class="role-pill role-${u.role}">${u.role.replace('_', ' ')}</span></td>
                          <td>
                            <span style="font-size:0.78rem;color:${u.is_active ? 'var(--success)' : 'var(--danger)'}">
                              ${u.is_active ? '● Active' : '○ Inactive'}
                            </span>
                          </td>
                          <td>
                            <div style="display:flex;gap:0.3rem;flex-wrap:wrap">
                              <button class="btn btn-secondary btn-sm" onclick="showEditUserModal('${u.id}')">Edit</button>
                              <button class="btn btn-secondary btn-sm" onclick="showResetUserPwModal('${u.id}')">Reset PW</button>
                              <button class="btn btn-secondary btn-sm" onclick="toggleUserActive('${u.id}',${u.is_active})">
                                ${u.is_active ? 'Deactivate' : 'Activate'}
                              </button>
                            </div>
                          </td>
                        </tr>
                      `).join('')}
                    </tbody>
                  </table>
                </div>
              `;
        }

        function showAddUserModal() {
            document.getElementById('modal-user-title').textContent = 'Add User';
            document.getElementById('edit-user-id').value = '';
            ['uf-name', 'uf-email', 'uf-password'].forEach(id => document.getElementById(id).value = '');
            document.getElementById('uf-role').value = 'reader';
            document.getElementById('uf-email-field').style.display = '';
            document.getElementById('uf-password-field').style.display = '';
            document.getElementById('uf-active-field').style.display = 'none';
            clearAlert('user-alert');
            openModal('modal-add-user');
        }

        function showEditUserModal(id) {
            const u = allUsers.find(u => u.id === id);
            if (!u) return;
            document.getElementById('modal-user-title').textContent = 'Edit User';
            document.getElementById('edit-user-id').value = u.id;
            document.getElementById('uf-name').value = u.name;
            document.getElementById('uf-email').value = u.email;
            document.getElementById('uf-role').value = u.role;
            document.getElementById('uf-active').value = u.is_active ? '1' : '0';
            document.getElementById('uf-email-field').style.display = 'none';
            document.getElementById('uf-password-field').style.display = 'none';
            document.getElementById('uf-active-field').style.display = '';
            clearAlert('user-alert');
            openModal('modal-add-user');
        }

        async function saveUser() {
            const id = document.getElementById('edit-user-id').value;
            const btn = document.getElementById('save-user-btn');
            btn.disabled = true;

            try {
                if (id) {
                    // Edit mode
                    const body = {
                        name: document.getElementById('uf-name').value.trim(),
                        role: document.getElementById('uf-role').value,
                        is_active: parseInt(document.getElementById('uf-active').value),
                    };
                    await apiPatch('/users/' + id, body);
                    toast('User updated.', 'success');
                } else {
                    // Create mode
                    const body = {
                        email: document.getElementById('uf-email').value.trim(),
                        name: document.getElementById('uf-name').value.trim(),
                        role: document.getElementById('uf-role').value,
                        password: document.getElementById('uf-password').value,
                    };
                    await apiFetch('/users', { method: 'POST', json: body });
                    toast('User created.', 'success');
                }
                closeModal('modal-add-user');
                loadAdminUsers();
            } catch (e) { showAlert('user-alert', e.message, 'error'); }
            finally { btn.disabled = false; }
        }

        async function toggleUserActive(id, current) {
            try {
                await apiPatch('/users/' + id, { is_active: current ? 0 : 1 });
                toast(current ? 'User deactivated.' : 'User activated.', 'success');
                loadAdminUsers();
            } catch (e) { toast(e.message, 'error'); }
        }

        function showResetUserPwModal(id) {
            document.getElementById('reset-user-id').value = id;
            document.getElementById('reset-new-pw').value = '';
            clearAlert('reset-user-alert');
            openModal('modal-reset-user-pw');
        }

        async function doResetUserPassword() {
            const id = document.getElementById('reset-user-id').value;
            const pw = document.getElementById('reset-new-pw').value;
            if (!pw || pw.length < 8) { showAlert('reset-user-alert', 'Min 8 characters.', 'error'); return; }
            try {
                await apiFetch('/users/' + id + '/reset-password', { method: 'POST', json: { newPassword: pw } });
                toast('Password reset and user notified.', 'success');
                closeModal('modal-reset-user-pw');
            } catch (e) { showAlert('reset-user-alert', e.message, 'error'); }
        }

        // ─── Utility ──────────────────────────────────────────────────────────────────
        function esc(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }
    </script>
</body>
</html>
